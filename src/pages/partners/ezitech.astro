---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const services = [
  {
    number: "01",
    title: "Custom software development",
    description: "Bespoke platforms, portals and SaaS products designed around a business workflow.",
    href: "https://portal.ezitech.org/go/MUHAMMAD-WWAP/software-project",
  },
  {
    number: "02",
    title: "Business software",
    description: "ERP, cloud POS, school, hospital, inventory, LMS, property, project and complaint-management systems.",
    href: "https://portal.ezitech.org/go/MUHAMMAD-WWAP/business-software",
  },
  {
    number: "03",
    title: "Websites and web portals",
    description: "Business websites, e-commerce stores and customer portals, scoped to the project.",
    href: "https://portal.ezitech.org/go/MUHAMMAD-WWAP/web-development",
  },
  {
    number: "04",
    title: "Mobile app development",
    description: "Android and iOS applications for businesses and startups.",
    href: "https://portal.ezitech.org/go/MUHAMMAD-WWAP/mobile-app",
  },
  {
    number: "05",
    title: "AI solutions and automation",
    description: "Chatbots, WhatsApp agents and workflow automation for business operations.",
    href: "https://portal.ezitech.org/go/MUHAMMAD-WWAP/ai-solutions",
  },
  {
    number: "06",
    title: "Digital marketing and SEO",
    description: "Social media, advertising and search-engine optimisation retainers.",
    href: "https://portal.ezitech.org/go/MUHAMMAD-WWAP/marketing-retainer",
  },
];
---
<SiteLayout title="Business Software, Websites & AI Services — Toolora" description="Explore software development, business systems, websites, mobile apps, AI automation and digital marketing services through Toolora's Ezitech partner links.">
  <SiteHeader />
  <main id="main-content">
    <section class="page-hero">
      <div class="container">
        <div class="breadcrumb"><a href="/">Home</a> / Partner services</div>
        <span class="eyebrow">Selected business solutions</span>
        <h1 class="display text-4xl md:text-5xl font-extrabold mt-3">Need software built for your business?</h1>
        <p class="text-slate-500 mt-3 text-sm max-w-2xl">Explore software development, business systems, websites, mobile apps, AI automation and digital marketing services offered by Ezitech.</p>
        <p class="text-xs text-slate-500 mt-3">Partner referral links · Pricing and project scope are confirmed by Ezitech.</p>
      </div>
    </section>
    <section class="section">
      <div class="container max-w-5xl">
        <div class="grid md:grid-cols-2 gap-5">
          {services.map((service) => (
            <article class="tool-panel p-6 md:p-8 flex flex-col">
              <span class="eyebrow">SERVICE {service.number}</span>
              <h2 class="display text-2xl font-bold mt-3">{service.title}</h2>
              <p class="text-slate-600 text-sm leading-7 mt-3">{service.description}</p>
              <a class="btn-primary inline-flex self-start mt-5" href={service.href} target="_blank" rel="sponsored nofollow noopener noreferrer">View service & enquire ↗</a>
            </article>
          ))}
        </div>
        <article class="tool-panel p-6 md:p-8 mt-6">
          <h2 class="display text-2xl font-bold">How the referral works</h2>
          <ul class="mt-4 list-disc pl-5 text-sm text-slate-600 space-y-2">
            <li>Open a service link and review the details on Ezitech.</li>
            <li>Contact Ezitech directly to discuss requirements, pricing and delivery.</li>
            <li>Ezitech attributes qualifying referrals through the partner code in the link.</li>
          </ul>
        </article>
        <p class="text-xs text-slate-500 mt-5">Affiliate disclosure: Toolora may earn a commission if you become a paying customer through one of these links. This does not add a referral fee to your price. Toolora is an independent referral partner and does not provide or guarantee Ezitech's services.</p>
        <p class="text-sm text-slate-500 mt-4">Provider: Ezitech Software House, Amna Plaza, Peshawar Road, Rawalpindi · <a class="underline" href="mailto:info@ezitech.org">info@ezitech.org</a></p>
      </div>
    </section>
  </main>
  <SiteFooter />
</SiteLayout>
