---
import SiteLayout from "../layouts/SiteLayout.astro";
import { tools, categories } from "../data/tools";
const query = (Astro.url.searchParams.get("q") ?? "").trim();
const normalized = query.toLowerCase();
const results = normalized ? tools.filter((tool) => `${tool.name} ${tool.description} ${tool.category}`.toLowerCase().includes(normalized)) : [];
const categoryName = (slug: string) => categories.find((category) => category.slug === slug)?.name ?? slug;
---
<SiteLayout title={`Search ${query ? `“${query}”` : "Tools"} — Toolora`} description="Search Toolora's online tools.">
  <header class="site-header"><div class="container flex items-center justify-between"><a href="/" class="flex items-center gap-3"><span class="brand-mark">T</span><span class="brand-name">toolora<span class="text-brand-600">.</span></span></a><a class="btn-secondary" href="/">← Home</a></div></header>
  <main><section class="page-hero"><div class="container"><div class="breadcrumb"><a href="/">Home</a> / Search</div><span class="eyebrow">Tool search</span><h1 class="display text-4xl font-extrabold mt-3">Search results</h1><form class="search-shell mx-0 max-w-2xl" action="/search" method="get"><input name="q" value={query} placeholder="Search tools..." aria-label="Search tools"/><button class="btn-primary">Search</button></form><p class="text-sm text-slate-500">{query ? `${results.length} result(s) for “${query}”` : "Enter a keyword to find a tool."}</p></div></section>
  <section class="section"><div class="container"><div class="tool-list">{results.map((tool)=><a class="tool-row" href={`/tools/${tool.slug}`}><span class="category-icon">{tool.icon.slice(0,2).toUpperCase()}</span><span><strong>{tool.name}</strong><p>{categoryName(tool.category)} · {tool.description}</p></span><span class="arrow">↗</span></a>)}</div>{query && results.length===0 && <div class="tool-panel text-center py-14"><h2 class="display text-2xl font-bold">No matching tools found</h2><p class="text-sm text-slate-500 mt-2">Try a different keyword or browse categories.</p><a class="btn-primary mt-5" href="/#categories">Browse categories</a></div>}</div></section></main>
  <footer class="site-footer"><div class="container"><span class="brand-name">toolora.</span><p>Created by Muhammad Ahmad ❤️</p><div class="footer-bottom"><span>© {new Date().getFullYear()} Toolora. All rights reserved.</span><a href="/">Back to home ↑</a></div></div></footer>
</SiteLayout>
