---
import SiteLayout from "../layouts/SiteLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---
<SiteLayout title="Page not found — Toolora" description="The page you requested could not be found.">
  <SiteHeader />
  <main id="main-content" class="min-h-screen grid place-items-center px-6 text-center">
    <div><span class="brand-mark mx-auto">T</span><p class="eyebrow mt-8">404 · Page not found</p><h1 class="display text-5xl font-extrabold mt-4">This page took a wrong turn.</h1><p class="text-slate-500 mt-4 max-w-md mx-auto">The link may be outdated or the page may have moved. Head back to Toolora and find what you need.</p><a href="/" class="btn-primary mt-7">Back to homepage →</a></div>
  </main>
  <SiteFooter />
</SiteLayout>
