---
import "../styles/studio-home.css";
import SiteLayout from "../layouts/SiteLayout.astro";
import Icon from "../components/Icon.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { categories, tools } from "../data/tools";
const featuredSlugs = ["image-compressor","pdf-to-images","word-counter","json-formatter","password-generator","qr-generator"];
const featuredTools = featuredSlugs.map((slug) => tools.find((tool) => tool.slug === slug)).filter(Boolean);
---
<SiteLayout title="Toolora — Free Online Tools for Everyone" description="A modern collection of free online tools for images, PDFs, writing, calculations, security and developer workflows. Fast, simple and easy to use.">
  <SiteHeader active="home" />
  <main id="main-content">
    <section class="hero hero-premium">
      <div class="container hero-layout">
        <div class="hero-content">
          <span class="eyebrow hero-eyebrow"><span class="eyebrow-dot"></span> Your everyday digital toolkit</span>
          <h1>Work smarter.<br/><span class="hero-gradient">Create more.</span></h1>
          <p class="hero-copy">Powerful, practical online tools that make everyday tasks easier. From images and documents to writing and developer utilities — everything in one place.</p>
          <form class="search-shell hero-search" action="/search/" method="get" id="tool-search">
            <span class="search-icon"><Icon name="search" size={20} /></span>
            <input id="search-input" name="q" type="search" placeholder="What do you want to do today?" aria-label="Search tools and categories"/>
            <button class="btn-primary" type="submit">Find a tool <Icon name="arrow-up-right" size={16}/></button>
          </form>
          <div class="popular-searches"><span>Popular:</span><a href="/categories/image/">Image compressor</a><a href="/categories/pdf/">PDF tools</a><a href="/tools/word-counter/">Word counter</a></div>
          <div class="hero-assurances"><span><Icon name="check" size={15}/> Free to use</span><span><Icon name="check" size={15}/> No installation</span><span><Icon name="check" size={15}/> Simple workflow</span></div>
        </div>
        <div class="hero-visual" aria-label="Preview of the Toolora workspace">
          <div class="visual-orbit orbit-one"></div><div class="visual-orbit orbit-two"></div>
          <div class="workspace-card">
            <div class="workspace-top"><div class="window-dots"><i></i><i></i><i></i></div><span>TOOLORA WORKSPACE</span><span class="workspace-live"><i></i> READY</span></div>
            <div class="workspace-welcome"><span class="workspace-spark"><Icon name="sparkles" size={18}/></span><div><strong>What are we working on?</strong><small>Choose a tool and get things done.</small></div></div>
            <div class="workspace-tiles">
              <a href="/categories/image/"><span class="tile-icon tile-blue"><Icon name="image" size={19}/></span><b>Image tools</b><small>Optimize & convert</small><Icon name="arrow-up-right" size={15}/></a>
              <a href="/categories/pdf/"><span class="tile-icon tile-violet"><Icon name="file-text" size={19}/></span><b>PDF tools</b><small>Manage documents</small><Icon name="arrow-up-right" size={15}/></a>
              <a href="/categories/text/"><span class="tile-icon tile-orange"><Icon name="type" size={19}/></span><b>Text tools</b><small>Write & analyze</small><Icon name="arrow-up-right" size={15}/></a>
              <a href="/categories/developer/"><span class="tile-icon tile-green"><Icon name="code" size={19}/></span><b>Developer</b><small>Format & convert</small><Icon name="arrow-up-right" size={15}/></a>
            </div>
            <div class="workspace-foot"><span><Icon name="shield-check" size={15}/> Your workflow, simplified</span><span>Explore all <b>{tools.length}</b> tools ↗</span></div>
          </div>
          <div class="floating-note note-top"><span class="note-check"><Icon name="check" size={13}/></span><span><b>Quick & easy</b><small>Tools ready when you are</small></span></div>
          <div class="floating-note note-bottom"><span class="note-icon"><Icon name="sparkles" size={16}/></span><span><b>One simple workspace</b><small>{categories.length} categories to explore</small></span></div>
        </div>
      </div>
    </section>
    <section class="stats-section"><div class="container stats-panel">
      <div class="stat-item"><span class="stat-icon"><Icon name="grid-2x2" size={19}/></span><div><strong>{categories.length} categories</strong><small>Organized for every workflow</small></div></div>
      <div class="stat-item"><span class="stat-icon"><Icon name="wrench" size={19}/></span><div><strong>{tools.length} useful tools</strong><small>Practical everyday utilities</small></div></div>
      <div class="stat-item"><span class="stat-icon"><Icon name="zap" size={19}/></span><div><strong>Easy access</strong><small>Open a tool and get started</small></div></div>
    </div></section>
    <section class="section categories-section" id="categories">
      <div class="container">
        <div class="section-heading"><div><span class="eyebrow">Explore the collection</span><h2>Everything has its place.</h2><p>Choose a category to reveal its tools. Only one category stays open at a time.</p></div><span class="section-counter">{categories.length} curated categories <span>↗</span></span></div>
        <div class="category-grid" id="category-accordion">
          {categories.map((category) => <details class="category-card category-accordion">
            <summary class="category-summary">
              <span class="category-icon"><Icon name={category.icon} size={22} /></span>
              <span class="category-info"><strong>{category.name}</strong><small>{category.description}</small></span>
              <span class="category-count">{tools.filter((tool) => tool.category === category.slug).length}<small>tools</small></span>
              <span class="category-toggle" aria-hidden="true"><Icon name="chevron-down" size={17}/></span>
            </summary>
            <div class="category-tools-list">
              {tools.filter((tool) => tool.category === category.slug).map((tool) => <a class="category-tool-link" href={`/tools/${tool.slug}/`}><span>{tool.name}</span><Icon name="arrow-up-right" size={15}/></a>)}
              <a class="category-view-all" href={`/categories/${category.slug}/`}>View {category.name} category <Icon name="arrow-up-right" size={14}/></a>
            </div>
          </details>)}
        </div>
      </div>
    </section>
    <section class="section popular-section" id="popular">
      <div class="container">
        <div class="section-heading"><div><span class="eyebrow">A good place to start</span><h2>Popular tools.</h2><p>Quick access to some of the most useful utilities.</p></div><a class="text-link" href="/search/?q=">Explore all tools <Icon name="arrow-up-right" size={16}/></a></div>
        <div class="featured-grid">{featuredTools.map((tool) => <a class="featured-card" href={`/tools/${tool!.slug}/`}><span class="featured-icon"><Icon name={tool!.icon} size={19}/></span><span class="featured-copy"><strong>{tool!.name}</strong><small>{tool!.description}</small></span><Icon name="arrow-up-right" size={17}/></a>)}</div>
      </div>
    </section>
    <section class="section about-section" id="about"><div class="container about-panel">
      <div class="about-mark"><span class="brand-mark">T</span><span class="eyebrow">The Toolora approach</span></div>
      <div class="about-copy"><h2>Less busywork.<br/><span class="hero-gradient">More meaningful work.</span></h2><p>Toolora brings practical digital utilities together in one focused workspace. Find the right tool, complete your task and get back to what matters.</p><a class="btn-primary" href="#categories">Explore the toolkit <Icon name="arrow-up-right" size={16}/></a></div>
      <div class="about-decoration"><span>TOOLS</span><span>MADE</span><span>SIMPLE.</span></div>
    </div></section>
  </main>
  <SiteFooter />
  <script>
    const categoryItems = Array.from(document.querySelectorAll<HTMLDetailsElement>(".category-accordion"));
    for (const item of categoryItems) {
      item.addEventListener("toggle", () => {
        if (!item.open) return;
        for (const other of categoryItems) {
          if (other !== item && other.open) other.open = false;
        }
      });
    }

    const form = document.querySelector<HTMLFormElement>("#tool-search");
    const input = document.querySelector<HTMLInputElement>("#search-input");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const query = input?.value.trim() ?? "";
      if (query) window.location.href = `/search?q=${encodeURIComponent(query)}`;
    });
  </script>
</SiteLayout>
