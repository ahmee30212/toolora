---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Owner sign in — Toolora" description="Owner authentication.">
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <main class="owner-auth-shell">
    <form id="owner-auth-form" class="owner-auth-card">
      <a href="/" class="owner-auth-brand">← Toolora</a>
      <p class="owner-auth-kicker">OWNER ACCESS</p>
      <h1>Sign in</h1>
      <p>Enter your private administrator password.</p>
      <label for="owner-password">Password</label>
      <input id="owner-password" type="password" minlength="20" maxlength="256" autocomplete="current-password" required />
      <button type="submit">Continue</button>
      <div id="owner-auth-status" role="status" aria-live="polite"></div>
    </form>
  </main>
  <style>
    .owner-auth-shell{min-height:70vh;display:grid;place-items:center;padding:28px;background:#f3f6fc}
    .owner-auth-card{width:min(100%,420px);display:grid;gap:12px;padding:30px;border:1px solid #dfe7f2;border-radius:18px;background:white;box-shadow:0 18px 50px #19365b12}
    .owner-auth-brand{color:#326cf4;font-size:12px;font-weight:800}.owner-auth-kicker{margin:15px 0 0;color:#71819a;font-size:10px;font-weight:800;letter-spacing:.14em}
    .owner-auth-card h1{margin:0;font-size:30px;font-weight:850}.owner-auth-card p{color:#71819a;font-size:12px}
    .owner-auth-card label{font-size:12px;font-weight:800}.owner-auth-card input{padding:13px;border:1px solid #dce5f1;border-radius:10px}
    .owner-auth-card button{padding:13px;border:0;border-radius:10px;background:#326cf4;color:white;font-weight:800}
    #owner-auth-status{min-height:20px;color:#b33a32;font-size:11px}
  </style>
  <script>
    const form = document.querySelector<HTMLFormElement>("#owner-auth-form");
    const password = document.querySelector<HTMLInputElement>("#owner-password");
    const status = document.querySelector<HTMLElement>("#owner-auth-status");
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!password || !status) return;
      const button = form.querySelector<HTMLButtonElement>("button");
      if (button) button.disabled = true;
      status.textContent = "Checking credentials…";
      try {
        const response = await fetch("/api/admin/login", {
          method: "POST", credentials: "same-origin",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify({ password: password.value })
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || "Sign-in failed.");
        password.value = "";
        location.assign("/admin/");
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : "Sign-in failed.";
      } finally { if (button) button.disabled = false; }
    });
  </script>
</SiteLayout>
