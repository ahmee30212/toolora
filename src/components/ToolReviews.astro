---
const { toolSlug, toolName } = Astro.props;
---
<section class="community-panel review-section" aria-labelledby="reviews-title" data-reviews-tool={toolSlug}>
  <div class="review-section-head">
    <div class="review-section-copy">
      <span class="eyebrow">Community feedback</span>
      <h2 id="reviews-title">Ratings &amp; reviews</h2>
      <p>Real feedback from people who have used {toolName}.</p>
    </div>
    <div class="review-summary" aria-live="polite">
      <strong data-average>—</strong>
      <span class="review-summary-stars" data-stars aria-label="No ratings yet">☆☆☆☆☆</span>
      <small data-count>Loading ratings…</small>
    </div>
  </div>

  <div class="review-overview" data-review-overview hidden>
    <div class="review-distribution" data-distribution aria-label="Rating distribution"></div>
    <div class="review-overview-note">
      <strong data-overview-count>0</strong>
      <span>approved community reviews</span>
    </div>
  </div>

  <div class="review-toolbar">
    <div><h3>What users are saying</h3><p>Reviews are published after moderation.</p></div>
    <label class="review-sort-label">Sort by
      <select data-review-sort aria-label="Sort reviews">
        <option value="newest">Most recent</option>
        <option value="highest">Highest rated</option>
        <option value="lowest">Lowest rated</option>
      </select>
    </label>
  </div>
  <div class="review-list" data-review-list aria-live="polite"><p class="community-muted">Loading reviews…</p></div>

  <form class="review-form" data-review-form>
    <div class="review-form-heading"><span class="eyebrow">Share your experience</span><h3>Write a review</h3><p>Your feedback helps us improve this tool for everyone.</p></div>
    <div class="review-form-grid">
      <label>Your name <span>(optional)</span><input name="displayName" maxlength="60" autocomplete="name" placeholder="Guest"></label>
      <label>Your rating<select name="rating" required><option value="">Select a rating</option><option value="5">★★★★★ — Excellent</option><option value="4">★★★★☆ — Very good</option><option value="3">★★★☆☆ — Good</option><option value="2">★★☆☆☆ — Fair</option><option value="1">★☆☆☆☆ — Poor</option></select></label>
    </div>
    <label class="review-message">Your review<textarea name="review" rows="4" minlength="10" maxlength="1000" required placeholder="Tell us what worked well and what could be better…"></textarea></label>
    <div class="review-submit-row"><button class="btn-primary" type="submit">Submit review <span aria-hidden="true">→</span></button><p class="community-status" data-review-status role="status" aria-live="polite"></p></div>
    <p class="review-privacy-note">Please don't include private or sensitive information. Reviews are checked before they appear publicly.</p>
  </form>
</section>
<script>
  interface ReviewItem {
    display_name?: string;
    rating?: number | string;
    review_text?: string;
    created_at?: string;
  }
  interface ReviewSummary {
    count?: number;
    average?: number;
    distribution?: number[];
  }

  const root = document.querySelector<HTMLElement>("[data-reviews-tool]");
  if (root && !root.hasAttribute("data-initialized")) {
    root.setAttribute("data-initialized", "true");
    const slug = root.dataset.reviewsTool || "";
    const list = root.querySelector<HTMLElement>("[data-review-list]");
    const form = root.querySelector<HTMLFormElement>("[data-review-form]");
    const status = root.querySelector<HTMLElement>("[data-review-status]");
    const average = root.querySelector<HTMLElement>("[data-average]");
    const stars = root.querySelector<HTMLElement>("[data-stars]");
    const count = root.querySelector<HTMLElement>("[data-count]");
    const overview = root.querySelector<HTMLElement>("[data-review-overview]");
    const distribution = root.querySelector<HTMLElement>("[data-distribution]");
    const overviewCount = root.querySelector<HTMLElement>("[data-overview-count]");
    const sort = root.querySelector<HTMLSelectElement>("[data-review-sort]");
    let currentReviews: ReviewItem[] = [];

    const renderReviews = () => {
      if (!list) return;
      const reviews = [...currentReviews];
      if (sort?.value === "highest") reviews.sort((a, b) => Number(b.rating) - Number(a.rating));
      if (sort?.value === "lowest") reviews.sort((a, b) => Number(a.rating) - Number(b.rating));
      list.replaceChildren();
      if (!reviews.length) {
        const empty = document.createElement("div");
        empty.className = "review-empty";
        const title = document.createElement("strong");
        title.textContent = "No reviews yet";
        const copy = document.createElement("p");
        copy.textContent = "Be the first to share a helpful review of this tool.";
        empty.append(title, copy);
        list.append(empty);
        return;
      }
      for (const review of reviews) {
        const article = document.createElement("article");
        article.className = "review-item";
        const top = document.createElement("div");
        top.className = "review-item-top";
        const identity = document.createElement("div");
        identity.className = "review-author";
        const avatar = document.createElement("span");
        avatar.className = "review-avatar";
        avatar.setAttribute("aria-hidden", "true");
        avatar.textContent = (String(review.display_name || "G").trim().charAt(0) || "G").toUpperCase();
        const author = document.createElement("strong");
        author.textContent = String(review.display_name || "Guest");
        identity.append(avatar, author);
        const meta = document.createElement("div");
        meta.className = "review-meta";
        const rating = Math.max(0, Math.min(5, Number(review.rating) || 0));
        const score = document.createElement("span");
        score.className = "review-stars";
        score.setAttribute("aria-label", rating + " out of 5 stars");
        score.textContent = "★".repeat(rating) + "☆".repeat(5 - rating);
        const date = document.createElement("time");
        date.className = "review-date";
        if (review.created_at) {
          const parsed = new Date(review.created_at.replace(" ", "T") + (review.created_at.endsWith("Z") ? "" : "Z"));
          if (!Number.isNaN(parsed.getTime())) {
            date.dateTime = parsed.toISOString();
            date.textContent = new Intl.DateTimeFormat(undefined, { dateStyle: "medium" }).format(parsed);
          }
        }
        meta.append(score, date);
        top.append(identity, meta);
        const body = document.createElement("p");
        body.textContent = String(review.review_text || "");
        article.append(top, body);
        list.append(article);
      }
    };

    const renderDistribution = (values: number[], total: number) => {
      if (!distribution) return;
      distribution.replaceChildren();
      for (let rating = 5; rating >= 1; rating--) {
        const row = document.createElement("div");
        row.className = "review-distribution-row";
        const label = document.createElement("span");
        label.textContent = String(rating);
        const star = document.createElement("span");
        star.className = "review-distribution-star";
        star.textContent = "★";
        const track = document.createElement("span");
        track.className = "review-distribution-track";
        const fill = document.createElement("span");
        fill.className = "review-distribution-fill";
        const amount = values[rating - 1] || 0;
        fill.style.width = (total ? amount / total * 100 : 0) + "%";
        track.append(fill);
        const value = document.createElement("small");
        value.textContent = String(amount);
        row.append(label, star, track, value);
        distribution.append(row);
      }
    };

    const loadReviews = async () => {
      if (!list || !average || !stars || !count) return;
      try {
        const response = await fetch("/api/reviews?tool=" + encodeURIComponent(slug), { headers: { accept: "application/json" } });
        if (!response.ok) throw new Error("Reviews are temporarily unavailable.");
        const data: { reviews?: ReviewItem[]; summary?: ReviewSummary } = await response.json();
        currentReviews = Array.isArray(data.reviews) ? data.reviews : [];
        const summary = data.summary || {};
        const total = Number(summary.count ?? currentReviews.length);
        const avg = Number(summary.average ?? 0);
        average.textContent = total ? avg.toFixed(1) + "/5" : "—";
        stars.textContent = total ? "★".repeat(Math.round(avg)) + "☆".repeat(5 - Math.round(avg)) : "☆☆☆☆☆";
        stars.setAttribute("aria-label", total ? avg.toFixed(1) + " out of 5 stars" : "No ratings yet");
        count.textContent = total + (total === 1 ? " approved review" : " approved reviews");
        if (overview && distribution && overviewCount) {
          overview.hidden = total === 0;
          overviewCount.textContent = String(total);
          renderDistribution(Array.isArray(summary.distribution) ? summary.distribution : [0,0,0,0,0], total);
        }
        renderReviews();
      } catch (error) {
        list.textContent = error instanceof Error ? error.message : "Could not load reviews.";
        count.textContent = "Ratings unavailable";
      }
    };

    sort?.addEventListener("change", renderReviews);
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (!button || !status) return;
      const values = new FormData(form);
      const payload = {
        tool: slug,
        displayName: String(values.get("displayName") || "").trim(),
        rating: Number(values.get("rating")),
        review: String(values.get("review") || "").trim()
      };
      if (payload.review.length < 10 || !Number.isInteger(payload.rating) || payload.rating < 1 || payload.rating > 5) {
        status.textContent = "Please select a rating and write at least 10 characters.";
        return;
      }
      button.disabled = true;
      status.textContent = "Submitting…";
      try {
        const response = await fetch("/api/reviews", {
          method: "POST",
          headers: { "content-type": "application/json", accept: "application/json" },
          body: JSON.stringify(payload)
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || "Your review could not be submitted.");
        form.reset();
        status.textContent = "Thank you. Your review is pending moderation and will appear after approval.";
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : "Submission failed. Please try again.";
      } finally {
        button.disabled = false;
      }
    });
    void loadReviews();
  }
</script>
