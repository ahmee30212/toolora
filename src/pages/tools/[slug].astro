---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Icon from "../../components/Icon.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ToolReviews from "../../components/ToolReviews.astro";
import { tools, categories } from "../../data/tools";
import { toolGuides } from "../../data/tool-guides";
export function getStaticPaths() { return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } })); }
const { tool } = Astro.props;
const category = categories.find((item) => item.slug === tool.category);
const guide = toolGuides[tool.slug];
if (!guide) throw new Error("Missing editorial guide for " + tool.slug);
---
<SiteLayout title={`${tool.name} — Toolora`} description={guide.overview.slice(0, 155)} breadcrumbs={[{ name: "Home", href: "/" }, { name: category?.name ?? "Category", href: `/categories/${tool.category}/` }, { name: tool.name, href: `/tools/${tool.slug}/` }]}>
  <SiteHeader backHref={`/categories/${tool.category}/`} backLabel={category?.name ?? "Category"} />
  <main id="main-content">
    <section class="page-hero tool-page-hero">
      <div class="container">
        <div class="breadcrumb"><a href="/">Home</a> / <a href={`/categories/${tool.category}/`}>{category?.name}</a> / {tool.name}</div>
        <div class="tool-page-title-row">
          <div><span class="eyebrow">Toolora workspace</span><h1 class="display text-4xl md:text-5xl font-extrabold mt-3">{tool.name}</h1><p class="text-slate-500 mt-3 text-sm max-w-2xl">{tool.description}</p></div>
          <span class="tool-page-symbol"><Icon name={tool.icon} size={27}/></span>
        </div>
        <div class="tool-trust-pills"><span class="pill"><Icon name="check" size={12}/> Free to use</span><span class="pill"><Icon name="shield-check" size={12}/> Browser-based</span><span class="pill"><Icon name="zap" size={12}/> No account required</span></div>
      </div>
    </section>
    <section class="section pt-10"><div class="container max-w-5xl">
      <div class="tool-panel workspace-panel">
        <div class="workspace-heading"><div><span class="eyebrow">Your workspace</span><h2>Ready when you are.</h2><p>Complete the input, run the tool and review your result.</p></div><span class="workspace-heading-icon"><Icon name={category?.icon ?? "sparkles"} size={24}/></span></div>
        <div id="tool-form" data-tool={tool.slug} class="workspace-grid">
          <section class="workspace-pane workspace-input-pane" aria-labelledby="input-panel-title">
            <div class="workspace-pane-title"><div><span class="workspace-step">01 · INPUT</span><h3 id="input-panel-title">Your content</h3></div><span class="workspace-pane-hint">Add your input below</span></div>
            <label class="block text-sm font-bold mb-2" for="tool-input" id="input-label">Input</label>
            <textarea id="tool-input" rows="9" class="tool-textarea w-full rounded-xl border border-slate-200 bg-slate-50 p-4 text-sm outline-none focus:border-blue-400 focus:ring-4 focus:ring-blue-50" placeholder="Enter or paste your content here..."></textarea>
            <div id="extra-fields" class="grid sm:grid-cols-2 gap-4 mt-4"></div>
            <div class="workspace-actions">
              <button class="btn-primary" id="run-tool" type="button"><Icon name="play" size={15}/> Run tool</button>
              <button class="btn-secondary" id="reset-tool" type="button"><Icon name="refresh-cw" size={15}/> Reset</button>
            </div>
            <p id="tool-status" class="tool-status text-xs text-slate-500 mt-4" role="status" aria-live="polite"><Icon name="info" size={14}/> Your input is processed in this browser whenever possible.</p>
          </section>
          <section class="workspace-pane workspace-output-pane" aria-labelledby="output-panel-title">
            <div class="workspace-pane-title"><div><span class="workspace-step">02 · OUTPUT</span><h3 id="output-panel-title">Your result</h3></div><span class="result-badge" id="result-meta">Waiting for input</span></div>
            <textarea id="tool-output" rows="9" readonly class="tool-textarea w-full rounded-xl border border-slate-200 bg-white p-4 text-sm outline-none" placeholder="Your result will appear here..."></textarea>
            {tool.slug === "markdown-editor" && <div id="markdown-preview" class="markdown-preview hidden" aria-live="polite"></div>}
            <div class="workspace-output-actions">
              <button class="btn-secondary" id="copy-result" type="button"><Icon name="copy" size={15}/> Copy result</button>
              <button class="btn-secondary" id="download-result" type="button"><Icon name="download" size={15}/> Download</button>
            </div>
            <p class="workspace-output-note"><Icon name="shield-check" size={14}/> Results stay in your browser unless a tool clearly states otherwise.</p>
          </section>
        </div>
      </div>
      <div class="help-grid mt-6">
        <div class="tool-panel help-card"><span class="help-icon"><Icon name="list-checks" size={18}/></span><strong>How to use</strong><p>Enter your information, select Run tool and review the result. Use Copy result or Download to save your work.</p></div>
        <div class="tool-panel help-card"><span class="help-icon"><Icon name="shield-check" size={18}/></span><strong>Privacy first</strong><p>Text-based operations run locally in your browser. File-based tools process selected files on your device whenever supported.</p></div>
      </div>
      <article class="tool-panel mt-6 p-6 md:p-9" aria-labelledby="tool-guide-title">
        <span class="eyebrow">Practical guide</span>
        <h2 id="tool-guide-title" class="display text-2xl md:text-3xl font-bold mt-2">How to use the {tool.name}</h2>
        <p class="text-slate-600 text-sm leading-7 mt-4">{guide.overview}</p>
        <h3 class="display text-xl font-bold mt-7">Step-by-step instructions</h3>
        <ol class="mt-4 space-y-4 list-decimal pl-5 text-sm leading-7 text-slate-700">
          {guide.steps.map((step, index) => <li><span class="font-semibold">Step {index + 1}.</span> {step}</li>)}
        </ol>
        <div class="mt-7 rounded-xl border border-slate-200 bg-slate-50 p-4">
          <h3 class="font-bold text-slate-900">Example use case</h3>
          <p class="text-sm text-slate-600 leading-7 mt-2">{guide.example}</p>
        </div>
        <div class="mt-5">
          <h3 class="font-bold text-slate-900">Helpful tip</h3>
          <p class="text-sm text-slate-600 leading-7 mt-2">{guide.tip}</p>
        </div>
        <section class="mt-8" aria-labelledby="tool-faq-title">
          <h3 id="tool-faq-title" class="display text-xl font-bold">Frequently asked questions</h3>
          <div class="mt-3 space-y-3">
            {guide.faqs.map((faq) => <details class="rounded-xl border border-slate-200 p-4">
              <summary class="cursor-pointer font-semibold text-slate-900">{faq.question}</summary>
              <p class="mt-3 text-sm leading-7 text-slate-600">{faq.answer}</p>
            </details>)}
          </div>
        </section>
      </article>
      <ToolReviews toolSlug={tool.slug} toolName={tool.name} />
    </div></section>
  </main>
  <SiteFooter />
  <script>import "../../scripts/tool-engine";</script>
</SiteLayout>
