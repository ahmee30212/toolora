---
import SiteLayout from "../layouts/SiteLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---
<SiteLayout title="Affiliate & Advertising Disclosure — Toolora" description="Toolora's policy for affiliate links, sponsored placements and advertising transparency.">
  <SiteHeader />
  <main id="main-content">
    <section class="page-hero"><div class="container"><div class="breadcrumb"><a href="/">Home</a> / Disclosure</div><span class="eyebrow">Transparency</span><h1 class="display text-4xl md:text-5xl font-extrabold mt-3">Affiliate & advertising disclosure.</h1><p class="text-slate-500 mt-3 text-sm max-w-2xl">How Toolora handles recommendations, partnerships and paid placements.</p></div></section>
    <section class="section"><div class="container max-w-3xl grid gap-5">
      <article class="tool-panel p-6 md:p-8"><h2 class="display text-2xl font-bold">Current status</h2><p class="text-slate-600 text-sm leading-7 mt-3">At the time this page was published, Toolora does not claim to have active affiliate partnerships, sponsored placements or an approved display-ad account. No recommendation on this website should be assumed to be a paid endorsement.</p></article>
      <article class="tool-panel p-6 md:p-8"><h2 class="display text-2xl font-bold">If affiliate links are introduced</h2><p class="text-slate-600 text-sm leading-7 mt-3">Toolora will identify affiliate links or qualifying recommendations clearly near the relevant link or content. If a visitor purchases through an affiliate link, Toolora may receive a commission at no additional cost to the visitor. Affiliate relationships will not guarantee that a product is suitable for every user.</p></article>
      <article class="tool-panel p-6 md:p-8"><h2 class="display text-2xl font-bold">Sponsored content and advertising</h2><p class="text-slate-600 text-sm leading-7 mt-3">Paid placements will be labelled as sponsored or advertising. Toolora will not publish fabricated reviews, ratings, testimonials, traffic figures or earnings claims. Editorial descriptions should remain distinguishable from paid promotions.</p></article>
      <article class="tool-panel p-6 md:p-8"><h2 class="display text-2xl font-bold">Questions</h2><p class="text-slate-600 text-sm leading-7 mt-3">For now, use the <a class="text-brand-700 underline" href="/community/">Toolora Community</a> page for site feedback. This page will be updated if Toolora enters a genuine commercial partnership.</p></article>
    </div></section>
  </main>
  <SiteFooter />
</SiteLayout>
