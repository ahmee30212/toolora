---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Account access — Toolora" description="Toolora account access.">
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <main class="decoy-shell">
    <section class="decoy-card">
      <a href="/" class="decoy-brand">← Toolora</a>
      <p class="decoy-kicker">ACCOUNT PORTAL</p>
      <h1>Sign in</h1>
      <p>Account access is currently unavailable. Please return to Toolora.</p>
      <button id="decoy-button" type="button">Continue</button>
      <p id="decoy-status" role="status" aria-live="polite"></p>
    </section>
  </main>
  <style>
    .decoy-shell{min-height:70vh;display:grid;place-items:center;padding:28px;background:#f3f6fc}
    .decoy-card{width:min(100%,420px);display:grid;gap:14px;padding:30px;border:1px solid #dfe7f2;border-radius:18px;background:white;box-shadow:0 18px 50px #19365b12}
    .decoy-brand{color:#326cf4;font-size:12px;font-weight:800}
    .decoy-kicker{margin:15px 0 0;color:#71819a;font-size:10px;font-weight:800;letter-spacing:.14em}
    .decoy-card h1{margin:0;font-size:30px;font-weight:850}
    .decoy-card p{color:#71819a;font-size:12px;line-height:1.7}
    .decoy-card button{padding:13px;border:0;border-radius:10px;background:#326cf4;color:white;font-weight:800}
    #decoy-status{min-height:20px}
  </style>
  <script>
    const button = document.querySelector<HTMLButtonElement>("#decoy-button");
    const status = document.querySelector<HTMLElement>("#decoy-status");
    button?.addEventListener("click", () => {
      if (status) status.textContent = "This service is currently unavailable. Please try again later.";
      if (button) button.disabled = true;
    });
  </script>
</SiteLayout>
