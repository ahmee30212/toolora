---
import SiteLayout from "../layouts/SiteLayout.astro";
import Icon from "../components/Icon.astro";
import { categories, tools } from "../data/tools";
---
<SiteLayout title="Toolora — Free Online Tools for Everyone" description="Simple, useful and accessible online tools for images, documents, writing, calculations and development.">
  <header class="site-header">
    <div class="container flex items-center justify-between">
      <a href="/" class="flex items-center gap-3"><span class="brand-mark">T</span><span class="brand-name">toolora<span class="text-brand-600">.</span></span></a>
      <nav class="desktop-nav flex items-center gap-8"><a class="nav-link" href="/">Home</a><a class="nav-link" href="#categories">Categories</a><a class="nav-link" href="#about">About</a></nav>
      <a class="btn-primary" href="#categories">Explore tools <Icon name="arrow-up-right" size={16} /></a>
    </div>
  </header>
  <main>
    <section class="hero text-center">
      <div class="container">
        <span class="eyebrow">Simple tools. Smarter work.</span>
        <h1>Everything you need.<br/><span class="text-brand-600">All in one place.</span></h1>
        <p class="hero-copy">A carefully organized collection of practical online tools to help you work faster. No complicated setup. Just open and use.</p>
        <form class="search-shell" action="/search" method="get" id="tool-search">
          <span class="text-slate-400 self-center pl-3"><Icon name="search" size={20} /></span>
          <input id="search-input" name="q" type="search" placeholder="Search tools and categories..." aria-label="Search tools and categories"/>
          <button class="btn-primary" type="submit">Search</button>
        </form>
        <div class="flex flex-wrap items-center justify-center gap-2"><span class="text-xs text-slate-400 font-semibold mr-1">Popular:</span><a class="pill" href="/categories/image">Image tools</a><a class="pill" href="/categories/pdf">PDF tools</a><a class="pill" href="/categories/security">Password tools</a><a class="pill" href="/categories/text">Word counter</a></div>
        <div class="flex flex-wrap justify-center gap-5 mt-8 text-xs font-semibold text-slate-500"><span class="trust-item"><Icon name="check" size={15} /> Free to use</span><span class="trust-item"><Icon name="check" size={15} /> Easy to access</span><span class="trust-item"><Icon name="check" size={15} /> No installation</span></div>
      </div>
    </section>
    <section class="container -mt-1">
      <div class="feature-strip">
        <div class="feature"><strong>{tools.length}+</strong><span>Curated tools</span></div>
        <div class="feature"><strong>{categories.length}</strong><span>Useful categories</span></div>
        <div class="feature"><strong>100%</strong><span>Online access</span></div>
      </div>
    </section>
    <section class="section" id="categories">
      <div class="container">
        <div class="section-heading"><div><span class="eyebrow">Browse by category</span><h2>Tools for every task</h2><p>Choose a category to see only the tools relevant to your work.</p></div><span class="pill">{categories.length} categories · {tools.length} tools</span></div>
        <div class="category-grid">
          {categories.map((category) => <a class="category-card" href={`/categories/${category.slug}`}><span class="category-icon"><Icon name={category.icon} size={22} /></span><span><strong>{category.name}</strong><small>{category.description}</small></span><span class="category-count">{tools.filter(t=>t.category===category.slug).length} tools</span></a>)}
        </div>
      </div>
    </section>
    <section class="section pt-0" id="about">
      <div class="container grid md:grid-cols-2 gap-10 items-center">
        <div><span class="eyebrow">About Toolora</span><h2 class="display text-4xl font-extrabold mt-3">Less hassle.<br/><span class="text-brand-600">More done.</span></h2></div>
        <div><p class="text-sm leading-8 text-slate-500">Toolora brings practical online utilities together in one focused workspace. Find the right tool by category, complete your task and get back to what matters.</p><a class="btn-secondary mt-3" href="#categories">Explore categories →</a></div>
      </div>
    </section>
  </main>
  <footer class="site-footer">
    <div class="container">
      <div class="flex flex-col md:flex-row justify-between gap-6"><div><a href="/" class="flex items-center gap-3"><span class="brand-mark">T</span><span class="brand-name">toolora.</span></a><p class="mt-3">Free Online Tools for Everyone.</p><p class="mt-2">Created by Muhammad Ahmad ❤️</p></div><div class="socials" aria-label="Social media">
        <a href="https://www.facebook.com/share/1EqQWrJG9J/" aria-label="Facebook" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.6-1.5h1.7V3.9c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3V10H7.3v3h2.8v8z" fill="currentColor"/></svg></a>
        <a href="https://www.instagram.com/muhammad.ahmad_official0/" aria-label="Instagram" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.5" cy="6.8" r="1" fill="currentColor"/></svg></a>
        <a href="https://www.tiktok.com/@muhammadahmad_official0" aria-label="TikTok" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.6 3c.3 2.2 1.5 3.6 3.4 3.8v3.1a8.2 8.2 0 0 1-3.4-.9v6.3a6.2 6.2 0 1 1-6.2-6.2c.4 0 .8 0 1.2.1v3.2a3.1 3.1 0 1 0 1.9 2.9V3z" fill="currentColor"/></svg></a>
        <a href="https://www.snapchat.com/add/m1ahmadofficial" aria-label="Snapchat" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.2c-2.2 0-3.5 1.6-3.5 4v2.2c-.5.5-1.2.8-2 .9-.5.1-.8.4-.7.8.1.4.7.6 1.2.7.6.1 1 .4 1.1.8.1.4-.2 1-.8 1.5-.8.7-1.7 1-2.4 1.1-.4.1-.6.3-.5.6.1.3.5.5 1 .6.7.1 1.3.4 1.7.9.5.6 1.4.9 2.2.8.7-.1 1.2.1 1.6.5.3.3.7.5 1.1.5s.8-.2 1.1-.5c.4-.4.9-.6 1.6-.5.8.1 1.7-.2 2.2-.8.4-.5 1-.8 1.7-.9.5-.1.9-.3 1-.6.1-.3-.1-.5-.5-.6-.7-.1-1.6-.4-2.4-1.1-.6-.5-.9-1.1-.8-1.5.1-.4.5-.7 1.1-.8.5-.1 1.1-.3 1.2-.7.1-.4-.2-.7-.7-.8-.8-.1-1.5-.4-2-.9V7.2c0-2.4-1.3-4-3.5-4Z" fill="currentColor"/></svg></a>
      </div></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Toolora. All rights reserved.</span><span>Built for a simpler digital workflow.</span></div>
    </div>
  </footer>
  <script>
    const form = document.querySelector<HTMLFormElement>("#tool-search");
    const input = document.querySelector<HTMLInputElement>("#search-input");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      const query = input?.value.trim() ?? "";
      if (query) window.location.href = `/search?q=${encodeURIComponent(query)}`;
    });
  </script>
</SiteLayout>
