---
import "../styles/global.css";
const { title = "Toolora — Free Online Tools", description = "A thoughtfully designed collection of free online tools.", robots = "index, follow, max-image-preview:large", breadcrumbs = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://toolora.gettoolora.workers.dev").toString();
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://toolora.gettoolora.workers.dev";
const organizationId = siteUrl + "/#organization";
const websiteId = siteUrl + "/#website";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: "Toolora",
      url: siteUrl + "/",
      description: "Free online tools for images, PDFs, writing, calculations, security and developer workflows."
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: "Toolora",
      url: siteUrl + "/",
      description: "Free online tools for everyone.",
      inLanguage: "en",
      publisher: { "@id": organizationId }
    },
    {
      "@type": "WebPage",
      "@id": canonical + "#webpage",
      url: canonical,
      name: title,
      description,
      inLanguage: "en",
      isPartOf: { "@id": websiteId },
      publisher: { "@id": organizationId }
    }
  ],
  ...(breadcrumbs.length ? [{
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((item: { name: string; href: string }, index: number) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.name,
      item: new URL(item.href, siteUrl).toString()
    }))
  }] : [])
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101f3b" />
    <meta name="color-scheme" content="light" />
    <meta name="robots" content={robots} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Toolora" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
