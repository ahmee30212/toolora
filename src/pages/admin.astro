---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Admin — Toolora" description="Private Toolora moderation dashboard.">
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <main class="admin-shell">
    <section class="admin-card">
      <a class="admin-brand" href="/">← Toolora</a>
      <p class="eyebrow">Private workspace</p>
      <h1>Community moderation</h1>
      <p class="admin-muted">Sign in to review pending community submissions. This dashboard does not expose pending content publicly.</p>
      <form id="admin-login" class="admin-login">
        <label for="admin-password">Admin password</label>
        <input id="admin-password" name="password" type="password" minlength="20" maxlength="256" autocomplete="current-password" required />
        <button class="btn-primary" type="submit">Sign in securely</button>
        <p id="login-status" class="admin-status" role="status" aria-live="polite"></p>
      </form>
      <div id="admin-content" hidden>
        <div class="admin-toolbar">
          <div><h2>Pending submissions</h2><p class="admin-muted">Approve or reject each item.</p></div>
          <button id="admin-refresh" class="btn-secondary" type="button">Refresh</button>
          <button id="admin-logout" class="btn-secondary" type="button">Sign out</button>
        </div>
        <h3>Reviews</h3>
        <div id="pending-reviews" class="admin-list" aria-live="polite"></div>
        <h3>Tool requests</h3>
        <div id="pending-requests" class="admin-list" aria-live="polite"></div>
        <p id="admin-status" class="admin-status" role="status" aria-live="polite"></p>
      </div>
    </section>
  </main>
  <style>
    .admin-shell{min-height:75vh;padding:55px 18px;background:linear-gradient(145deg,#edf3ff,#f8faff)}
    .admin-card{max-width:850px;margin:auto;padding:30px;border:1px solid #dce5f1;border-radius:20px;background:#fff;box-shadow:0 20px 55px #1d355712}
    .admin-brand{display:inline-block;margin-bottom:25px;color:#326cf4;font-size:12px;font-weight:800}
    .admin-card h1{margin:8px 0;font-size:clamp(27px,4vw,38px);font-weight:850;letter-spacing:-.05em}
    .admin-card h2{font-size:20px;font-weight:800}.admin-card h3{margin:24px 0 10px;font-size:15px;font-weight:800}
    .admin-muted{color:#77869b;font-size:12px;line-height:1.7}
    .admin-login{display:grid;gap:10px;max-width:420px;margin-top:25px}
    .admin-login label{font-size:12px;font-weight:800}
    .admin-login input{width:100%;padding:12px;border:1px solid #dce5f1;border-radius:10px;background:#fbfcff}
    .admin-login button{justify-self:start}
    .admin-toolbar{display:flex;align-items:center;gap:10px;justify-content:space-between;flex-wrap:wrap;margin-top:30px;padding-top:20px;border-top:1px solid #edf0f5}
    .admin-toolbar h2,.admin-toolbar p{margin:0}
    .admin-list{display:grid;gap:10px}
    .admin-item{padding:16px;border:1px solid #e7edf5;border-radius:12px;background:#fbfcff}
    .admin-item strong{display:block;font-size:13px}
    .admin-item p{margin:8px 0;color:#596981;font-size:12px;line-height:1.7;overflow-wrap:anywhere;white-space:pre-wrap}
    .admin-meta{color:#8a97aa;font-size:10px}
    .admin-actions{display:flex;gap:8px;flex-wrap:wrap}
    .admin-actions button{padding:8px 12px;border:1px solid #dce5f1;border-radius:9px;background:#fff;font-size:11px;font-weight:800}
    .admin-actions button[data-action="approved"]{background:#eaf8f1;border-color:#c9edda;color:#14784e}
    .admin-actions button[data-action="rejected"]{background:#fff1f0;border-color:#f4d4d1;color:#b33a32}
    .admin-status{min-height:18px;margin:8px 0 0;color:#536783;font-size:11px}
    @media(max-width:600px){.admin-card{padding:20px}.admin-toolbar{justify-content:flex-start}.admin-toolbar>div{width:100%}}
  </style>
  <script>
    type QueueItem = { id: number; tool_slug?: string; name?: string; rating?: number; review?: string; tool_name?: string; description?: string; created_at?: string };
    const loginForm = document.querySelector<HTMLFormElement>("#admin-login");
    const loginStatus = document.querySelector<HTMLElement>("#login-status");
    const adminContent = document.querySelector<HTMLElement>("#admin-content");
    const reviewsBox = document.querySelector<HTMLElement>("#pending-reviews");
    const requestsBox = document.querySelector<HTMLElement>("#pending-requests");
    const adminStatus = document.querySelector<HTMLElement>("#admin-status");
    const passwordInput = document.querySelector<HTMLInputElement>("#admin-password");

    async function api<T>(path: string, init?: RequestInit): Promise<T> {
      const response = await fetch(path, { ...init, credentials: "same-origin", headers: { accept: "application/json", ...(init?.headers || {}) } });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        if (response.status === 401 && path !== "/api/admin/login") {
          if (adminContent) adminContent.hidden = true;
          if (loginForm) loginForm.hidden = false;
          if (loginStatus) loginStatus.textContent = "Your admin session ended or was replaced by another login.";
        }
        throw new Error(data.error || "Request failed.");
      }
      return data as T;
    }

    function emptyMessage(target: HTMLElement | null, message: string) {
      if (!target) return;
      const p = document.createElement("p");
      p.className = "admin-muted";
      p.textContent = message;
      target.replaceChildren(p);
    }

    function renderQueue(target: HTMLElement | null, items: QueueItem[], kind: "review" | "tool-request") {
      if (!target) return;
      if (!items.length) { emptyMessage(target, "Nothing pending."); return; }
      const fragment = document.createDocumentFragment();
      for (const item of items) {
        const card = document.createElement("article");
        card.className = "admin-item";
        const heading = document.createElement("strong");
        heading.textContent = kind === "review"
          ? (item.tool_slug || "Tool") + " — " + (item.name || "Guest") + " (" + String(item.rating || 0) + "/5)"
          : item.tool_name || "Tool request";
        const body = document.createElement("p");
        body.textContent = kind === "review" ? item.review || "" : item.description || "";
        const meta = document.createElement("div");
        meta.className = "admin-meta";
        meta.textContent = item.created_at || "";
        const actions = document.createElement("div");
        actions.className = "admin-actions";
        for (const status of ["approved", "rejected"] as const) {
          const button = document.createElement("button");
          button.type = "button";
          button.dataset.action = status;
          button.textContent = status === "approved" ? "Approve" : "Reject";
          button.addEventListener("click", () => moderate(kind, item.id, status, button));
          actions.append(button);
        }
        card.append(heading, body, meta, actions);
        fragment.append(card);
      }
      target.replaceChildren(fragment);
    }

    async function loadPending() {
      if (adminStatus) adminStatus.textContent = "Loading pending submissions…";
      const data = await api<{ reviews: QueueItem[]; requests: QueueItem[] }>("/api/admin/pending");
      renderQueue(reviewsBox, data.reviews || [], "review");
      renderQueue(requestsBox, data.requests || [], "tool-request");
      if (adminStatus) adminStatus.textContent = "Queue refreshed.";
    }

    async function moderate(kind: "review" | "tool-request", id: number, status: "approved" | "rejected", button: HTMLButtonElement) {
      button.disabled = true;
      try {
        await api("/api/admin/moderate", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ kind, id, status }) });
        if (adminStatus) adminStatus.textContent = "Submission " + status + ".";
        await loadPending();
      } catch (error) {
        if (adminStatus) adminStatus.textContent = error instanceof Error ? error.message : "Moderation failed.";
        button.disabled = false;
      }
    }

    async function showDashboard() {
      await api("/api/admin/session");
      if (loginForm) loginForm.hidden = true;
      if (adminContent) adminContent.hidden = false;
      await loadPending();
    }

    loginForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!passwordInput || !loginStatus) return;
      const button = loginForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) button.disabled = true;
      loginStatus.textContent = "Signing in…";
      try {
        await api("/api/admin/login", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ password: passwordInput.value }) });
        passwordInput.value = "";
        await showDashboard();
      } catch (error) {
        loginStatus.textContent = error instanceof Error ? error.message : "Sign-in failed.";
      } finally {
        if (button) button.disabled = false;
      }
    });

    document.querySelector("#admin-refresh")?.addEventListener("click", () => loadPending().catch(error => { if (adminStatus) adminStatus.textContent = error.message; }));
    document.querySelector("#admin-logout")?.addEventListener("click", async () => {
      try { await api("/api/admin/logout", { method: "POST" }); }
      finally { if (adminContent) adminContent.hidden = true; if (loginForm) loginForm.hidden = false; if (loginStatus) loginStatus.textContent = "Signed out."; }
    });

    void showDashboard().catch(() => { if (loginStatus) loginStatus.textContent = "Sign in to access the private moderation dashboard."; });
  </script>
</SiteLayout>
